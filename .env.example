# Spendify environment variables
# Copy to .env.local and fill in. Leave the Supabase values empty to run in demo mode
# (sample statements, no login, nothing saved).

# ── Supabase (login) ─────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Postgres (your data) ─────────────────────────────────────────────────────────
# Supabase dashboard → Connect → "Transaction pooler" string (port 6543), with your
# database password filled in. Server-only: never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# ── Tests (optional) ─────────────────────────────────────────────────────────────
# A Postgres server the repository tests may create throwaway databases on.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
