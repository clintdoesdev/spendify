# Spendify environment variables
# Copy to .env.local for local development. Leave DATABASE_URL empty to run in demo mode
# (sample statements, no login, nothing saved).

# Postgres connection string. This is the only variable Spendify needs.
# On Railway: add a PostgreSQL service, then in your app service's Variables set
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Locally: any Postgres, e.g. Railway's public URL (Postgres service → Connect → Public Network).
# Server-only. Never expose it to the browser.
DATABASE_URL=postgresql://postgres:password@localhost:5432/spendify

# Tests (optional): a Postgres server the repository tests may create throwaway databases on.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
